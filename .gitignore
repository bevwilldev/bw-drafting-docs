# Never commit these — the old site leaked server paths and client job data
# through exactly these kinds of files.
error_log
*.log
*.zip
*.arg

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

# Cloudflare Worker (the assistant endpoint).
# .dev.vars is where wrangler keeps secrets for local runs - it is the one
# file that would put the API key in the repo, so it is ignored before anyone
# creates it. The deployed secret lives with Cloudflare (wrangler secret put)
# and is never written here.
worker/.dev.vars
worker/.wrangler/
worker/node_modules/
